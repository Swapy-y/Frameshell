/* Frame - rofi  ->  ~/.config/rofi/config.rasi
   The shell has its own app launcher (SUPER + R); rofi is kept as
   a backup launcher (`rofi -show drun`). */

configuration {
    modi:                 "drun,run,window";
    show-icons:           true;
    icon-theme:           "YAMIS";
    drun-display-format:  "{name}";
    display-drun:         "Apps";
    display-run:          "Run";
    display-window:       "Windows";
    display-combi:        "";
    matching:             "fuzzy";
    sorting-method:       "fzf";
    sort:                 true;
    hover-select:         true;
    me-select-entry:      "";
    me-accept-entry:      "MousePrimary";
    kb-cancel:            "Escape,Control+g";
}

@theme "frame"
